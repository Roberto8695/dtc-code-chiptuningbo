                    dtcCode = await _repository.GetByIdAsync(selectedResult.DtcId.Value);
                }
                else
                {
                    var obdType = string.IsNullOrWhiteSpace(selectedResult.ObdType) ? "OBD-II" : selectedResult.ObdType;
